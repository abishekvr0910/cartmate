{
  "name": "cartmate-qa",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone Playwright E2E User Journey & Accessibility Test Suite for CartMate",
  "scripts": {
    "test": "playwright test",
    "test:no-demo": "playwright test --config=playwright.no-demo.config.ts",
    "test:operator-pilot": "playwright test --config=playwright.operator-pilot.config.ts",
    "test:pods-and-voice": "python run_pods_and_voice.py",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  }
}
