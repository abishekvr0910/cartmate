# Checklist only. Do not put real secrets or production data in this file.
CARTMATE_ENV=staging
CARTMATE_DEPLOYMENT=1
CARTMATE_DATABASE_PATH=/var/data/cartmate.db
SESSION_TTL_HOURS=24
# Same-origin React/API deployment needs no cross-origin CORS entry.
CARTMATE_CORS_ALLOWED_ORIGINS=
# Comma-separated, privately configured approved handsets only.
CARTMATE_STAGING_ALLOWED_PHONES=
CARTMATE_MODERATOR_USER_IDS=
# Staging-only, off by default. Enable only for a reviewed, operator-witnessed
# two-person pilot; production ignores this flag and stays closed.
CARTMATE_MANUAL_AGE_PILOT_ENABLED=0
# Choose smsapi only if an eligible organization owns the account, or twilio
# with a paid account and a Polish sender proven by a real delivery test.
OTP_PROVIDER=
SMSAPI_API_TOKEN=
SMSAPI_SENDER=
# For OTP_PROVIDER=twilio, set all three Twilio fields instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SOS_PROVIDER=disabled
SOS_WEBHOOK_SECRET=
JEV_MODE=disabled
