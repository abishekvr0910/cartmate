# CartMate closed-pilot cloud staging environment template (no real secrets here)
# Copy this file to .env on your AWS instance: cp .env.production.example .env

# Your public domain pointing to the instance IP (e.g. cartmate.example.com or api.yourdomain.com)
DOMAIN=cartmate.example.com

# Staging Pilot Flags
CARTMATE_ENV=staging
CARTMATE_DEPLOYMENT=1
CARTMATE_OPERATOR_PILOT_ENABLED=1
CARTMATE_MANUAL_AGE_PILOT_ENABLED=1

# Storage and CORS (Origin must match your DOMAIN and localhost for Capacitor)
CARTMATE_DATABASE_PATH=/app/data/pilot_live.db
CARTMATE_CORS_ALLOWED_ORIGINS=https://cartmate.example.com,https://localhost

# Moderator User IDs (populate after redeeming operator accounts)
CARTMATE_MODERATOR_USER_IDS=

# Required by the deployment guard even when the staging pilot uses operator admission.
# List only approved Polish test handsets; keep real numbers in the private .env file.
CARTMATE_STAGING_ALLOWED_PHONES=

# Generate a unique random value of at least 16 characters for the private .env file.
SOS_WEBHOOK_SECRET=

# WebRTC TURN relay (coturn runs on this EC2 host; required for H-02).
# Generate the secret with: openssl rand -hex 32
CARTMATE_TURN_SECRET=
# The EC2 Elastic IP. coturn advertises it as the public relay address.
CARTMATE_TURN_EXTERNAL_IP=
# The instance's private IPv4 from the EC2 console; coturn relays through it behind AWS 1:1 NAT.
CARTMATE_TURN_PRIVATE_IP=
# docker-compose.yml sets CARTMATE_TURN_HOST=DOMAIN; UDP/TCP 3478 use the same hostname.

# Operational safety invariants
SOS_PROVIDER=disabled
OTP_PROVIDER=console
JEV_MODE=disabled
SESSION_TTL_HOURS=24
PORT=8000
